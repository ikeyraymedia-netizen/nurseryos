rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isTenantMember(tenantId) {
      return signedIn()
        && firestore.exists(
          /databases/(default)/documents/tenants/$(tenantId)/members/$(request.auth.uid)
        );
    }

    // Plant photos — public read so PDF/Excel “View photo” links work without login.
    // Writes require nursery membership (Storage↔Firestore rules must be linked in Firebase).
    match /tenants/{tenantId}/inventory/{plantId}/{fileName} {
      allow read: if true;
      allow create, update: if isTenantMember(tenantId)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isTenantMember(tenantId);
    }

    // Estimate line photos — public read so customers can open View photo without login.
    match /tenants/{tenantId}/estimatePhotos/{lineId}/{fileName} {
      allow read: if true;
      allow create, update: if isTenantMember(tenantId)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isTenantMember(tenantId);
    }

    // Scanned vendor invoices (image or PDF) — members only.
    match /tenants/{tenantId}/vendorBills/{billId}/{fileName} {
      allow read: if isTenantMember(tenantId);
      allow create, update: if isTenantMember(tenantId)
        && request.resource.size < 12 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf'
        );
      allow delete: if isTenantMember(tenantId);
    }
  }
}
