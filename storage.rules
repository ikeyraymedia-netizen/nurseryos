rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isTenantMember(tenantId) {
      return signedIn()
        && firestore.exists(
          /databases/(default)/documents/tenants/$(tenantId)/members/$(request.auth.uid)
        );
    }

    // Plant photos — public read so availability emails can link to them.
    match /tenants/{tenantId}/inventory/{plantId}/{fileName} {
      allow read: if true;
      allow write: if isTenantMember(tenantId)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isTenantMember(tenantId);
    }
  }
}
