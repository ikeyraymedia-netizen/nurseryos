rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    // Plant photos — public read so PDF/Excel “View photo” links work without login.
    // Writes require sign-in. (Avoid firestore.exists here: until Storage↔Firestore
    // cross-service IAM is granted in the Firebase console, membership checks
    // fail closed as storage/unauthorized.)
    match /tenants/{tenantId}/inventory/{plantId}/{fileName} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if signedIn();
    }

    // Scanned vendor invoices (image or PDF) — signed-in read/write.
    match /tenants/{tenantId}/vendorBills/{billId}/{fileName} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.size < 12 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf'
        );
      allow delete: if signedIn();
    }
  }
}
